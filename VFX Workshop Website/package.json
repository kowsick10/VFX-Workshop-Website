{
  "name": "i5-vfx-studio-registration",
  "version": "1.0.0",
  "description": "i5 VFX Studio Single-Page Student Registration Landing Page & Razorpay Checkout",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
