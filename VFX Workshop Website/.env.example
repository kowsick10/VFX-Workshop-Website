# ==============================================================================
# i5 VFX STUDIO - STUDENT REGISTRATION & PAYMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Get your API keys from Razorpay Dashboard -> Settings -> API Keys:
# https://dashboard.razorpay.com/#/app/keys
#
# NOTE: You can use Test Keys (rzp_test_...) or Live Keys (rzp_live_...)
# If left blank, the application runs in Development / Simulation Mode.

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_KEY_HERE

# Razorpay Webhook Secret (Dashboard -> Settings -> Webhooks)
# Set the webhook URL to: https://yourdomain.com/api/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# 2. MICROSOFT FORM / POWER AUTOMATE INTEGRATION
# ------------------------------------------------------------------------------
# If you want student registrations to automatically sync to a Microsoft Form,
# MS Teams channel, Excel sheet, or Power Automate workflow, paste your HTTP
# POST webhook trigger URL here:
# (e.g. Power Automate "When an HTTP request is received" URL)

MICROSOFT_FORM_WEBHOOK_URL=https://prod-xx.southeastasia.logic.azure.com:443/workflows/YOUR_WEBHOOK_URL_HERE

# Optional integration settings
STUDIO_CONTACT_EMAIL=info@i5vfxstudio.com
STUDIO_CONTACT_PHONE=+919791070214
